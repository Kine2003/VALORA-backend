PORT=3000
DATABASE_URL=postgresql://usuario:contraseña@host:5432/valora
NODE_ENV=production
APP_ORIGIN=https://tu-servicio.onrender.com
FRONTEND_ORIGIN=https://tu-servicio.onrender.com
FRONTEND_DIR=./public
# Generar con node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=REEMPLAZAR_POR_CLAVE_ALEATORIA_BASE64URL
JWT_ISSUER=valora
JWT_AUDIENCE=valora-web

# Cuenta del panel administrativo creada por `npm run db:seed`.
# Sustituya ambos secretos por valores privados antes de sembrar.
ADMIN_CORREO=admin@example.com
ADMIN_PASSWORD=CAMBIAR_POR_SECRETO_PRIVADO
PAGO_SIMULADO=false
