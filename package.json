{
  "name": "valora-web",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "Válora, aplicación cliente-servidor con PostgreSQL.",
  "scripts": {
    "start": "node --env-file-if-exists=.env servidor.js",
    "db:migrate": "node --env-file-if-exists=.env migrar.js",
    "db:seed": "node --env-file-if-exists=.env sembrar.js",
    "validate": "node scripts/validate-backend.mjs",
    "test:api": "node scripts/smoke-api.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "jsdom": "30.1.3"
  },
  "dependencies": {
    "pg": "^8.16.3"
  }
}
